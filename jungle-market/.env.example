API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=False
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_API_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Use your direct or session-pooler URI; percent-encode the database password.
DATABASE_URL=postgresql://postgres:encoded-password@db.your-project.supabase.co:5432/postgres
# Download from Database Settings > SSL configuration if required.
DATABASE_SSL_ROOT_CERT=
COLAB_ML_URL=
COLAB_ML_API_KEY=replace-with-a-shared-random-value
COLAB_ML_TIMEOUT_SECONDS=120
COLAB_ML_HEALTH_TIMEOUT_SECONDS=10
ML_LOCAL_FALLBACK=False
# Optional text-only translation; audio translation uses Colab Whisper.
FACTORY_API_KEY=
FACTORY_API_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_MODEL=

# Private media storage (server only; never NEXT_PUBLIC)
MEDIA_STORAGE=local
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=jungle-market-private
