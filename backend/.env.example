ENVIRONMENT=local
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

POSTGRES_USER=jungle
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=jungle_market
DATABASE_URL=postgresql+psycopg://jungle:replace_me@postgres:5432/jungle_market
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LOCAL_STORAGE_ROOT=/data/jungle-market-media
MAX_IMAGE_BYTES=12582912
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_LONG_EDGE=1600
MAX_AUDIO_BYTES=26214400
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/webm
ENABLE_UNEVEN_LIGHT_NORMALIZATION=false

CATEGORY_LABELS=basket,pottery,textile,jewellery,woodcraft,bamboo_craft,decor,bag,accessory
MATERIAL_LABELS=bamboo,wood,clay,cotton,jute,metal,leather

RT_DETR_MODEL_PATH=
CATEGORY_MODEL_PATH=
MATERIAL_MODEL_PATH=
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MIN_TRANSCRIPT_CONFIDENCE=0.62
CATBOOST_PRICING_MODEL_PATH=

MIN_MASK_AREA_RATIO=0.02
MAX_PRICING_MODEL_STALENESS_DAYS=90
DEFAULT_CURRENCY=INR
MINIMUM_MARGIN_RATE=0.22

# ==========================================
# External API Gateway Keys
# ==========================================
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
NGROK_TOKEN=your_ngrok_token_here
